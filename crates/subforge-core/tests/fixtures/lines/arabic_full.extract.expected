[{"id": 0, "start": 1000, "end": 3500, "text": "\u0645\u0631\u062d\u0628\u0627 \u0628\u0627\u0644\u0639\u0627\u0644\u0645"}, {"id": 1, "start": 4000, "end": 6250, "text": "\u0643\u064a\u0641 \u062d\u0627\u0644\u0643 \u0627\u0644\u064a\u0648\u0645\u061f \u0647\u0630\u0647 \u062a\u0631\u062c\u0645\u0629 \u062a\u062c\u0631\u064a\u0628\u064a\u0629"}, {"id": 2, "start": 6500, "end": 7000, "text": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0644\u0645\u062a\u0631\u062c\u0645"}, {"id": 3, "start": 7000, "end": 9990, "text": "\u0625\u0644\u0649 \u0627\u0644\u0644\u0642\u0627\u0621, \u0634\u0643\u0631\u0627 \u0644\u0643\u0645 \u062c\u0645\u064a\u0639\u0627"}, {"id": 4, "start": 10000, "end": 12000, "text": ""}, {"id": 5, "start": 62100, "end": 65000, "text": "\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0643\u0645 \u0648\u0631\u062d\u0645\u0629 \u0627\u0644\u0644\u0647"}]
