{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "subforge",
  "version": "0.2.0",
  "identifier": "com.updullah.subforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SubForge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UPdullah895",
    "copyright": "Copyright (c) UPdullah895. GPL-3.0-only.",
    "category": "Utility",
    "shortDescription": "Subtitle and audio toolkit",
    "longDescription": "Extract, merge, convert, transcribe and translate subtitles and audio tracks. Uses MKVToolNix and FFmpeg.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["mkvtoolnix", "ffmpeg", "libvulkan1"]
      },
      "rpm": {
        "depends": ["mkvtoolnix", "(ffmpeg or ffmpeg-free)", "(vulkan-loader or libvulkan1)"]
      }
    }
  }
}
